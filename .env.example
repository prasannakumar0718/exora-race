# Lane Rush — Environment Configuration
# Copy this file to .env for local overrides if needed.

# Listening port (in cloud platforms such as Render, Railway, or Heroku, this is provided automatically)
PORT=8080

# Network bind address (use 0.0.0.0 to bind all public/container interfaces)
HOST=0.0.0.0

# Optional: Comma-separated list of allowed origins for WebSocket connections.
# Leave blank to allow any origin (recommended for development and single-host deployments).
# Example: ALLOWED_ORIGINS=https://mygame.onrender.com,https://lanerush.example.com
ALLOWED_ORIGINS=

# Maximum concurrent rooms stored in server memory (default: 500)
MAX_ROOMS=500

# Reconnection grace window in milliseconds (default: 45000 = 45 seconds)
RECONNECT_GRACE_MS=45000

# Server simulation tick duration in milliseconds (default: 50 = 20 Hz)
TICK_MS=50
